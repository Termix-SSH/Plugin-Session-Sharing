        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      },
      "body": {
        "userId": null
      }
    },
    "POST /plugin-api/session-sharing/rooms/:id/control/request": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      }
    },
    "GET /plugin-api/session-sharing/rooms/:id/control/requests": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      }
    },
    "DELETE /plugin-api/session-sharing/rooms/:id/control/requests/:userId": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      },
      "destructive": true
    },
    "POST /plugin-api/session-sharing/rooms/:id/end": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      }
    },
    "POST /plugin-api/session-sharing/rooms/:id/guest-link": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      },
      "body": {
        "enabled": false
      }
    },
    "POST /plugin-api/session-sharing/rooms/:id/guests/remove": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      },
      "destructive": true
    },
    "POST /plugin-api/session-sharing/rooms/:id/members": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
        "id": "session-sharing.rooms"
      },
      "body": {
        "userIds": ["{{user:other}}"]
      }
    },
    "DELETE /plugin-api/session-sharing/rooms/:id/members/:userId": {
      "access": "user",
      "resource": {
        "kind": "own",
        "fixture": "session-sharing.rooms"
      },
      "params": {
